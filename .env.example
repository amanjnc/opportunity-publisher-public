# Copy to .env and fill your own secrets. NEVER publish this file.

# To read Telegram channels, create your own application at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Create a bot using @BotFather and give it permission to post in your destination channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_TARGET_CHANNEL=@YOUR_CHANNEL_USERNAME

# Optional AI organization. Without it, fields are extracted conservatively.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional LinkedIn API publishing. Requires authorized OAuth access + correct posting permissions.
# Leave blank for manual copy-and-paste from the dashboard.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# Set to a currently supported YYYYMM version in the LinkedIn Posts API documentation.
LINKEDIN_API_VERSION=202609

# Keep false until you have reviewed sources, approved posts, tested the Telegram bot.
AUTO_PUBLISH=false
# Set true only after confirming your LinkedIn app/API authorization and permissions.
AUTO_LINKEDIN=false
